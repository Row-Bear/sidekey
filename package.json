{
  "name": "stellar-smart-account-poc",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "web": "vite web",
    "web:build": "vite build web",
    "setup:accounts": "tsx scripts/01-setup-accounts.ts",
    "build:contract": "stellar contract build",
    "test:contract": "cargo test -p smart-account",
    "test:web": "tsx --test web/server/guard.test.ts web/src/addressBook.test.ts web/src/api.test.ts web/src/signers.test.ts web/src/expiry.test.ts web/src/examples.test.ts",
    "test:core": "tsx --test packages/core/test/*.test.ts",
    "e2e:broker": "tsx spikes/broker/run.ts",
    "e2e:wallet": "tsx spikes/broker/wallet-mode.ts",
    "e2e:passkey": "tsx spikes/broker/passkey-mode.ts",
    "e2e:lessthan": "tsx spikes/less-than/run.ts",
    "deploy:account": "tsx scripts/02-deploy-smart-account.ts",
    "poc": "tsx scripts/03-run-poc.ts",
    "export:run": "tsx scripts/04-export-run.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
